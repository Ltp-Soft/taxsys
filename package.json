{
  "name": "auto-voice-tax-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Tax Invoice Sync Monorepo (Backend + Extension + Frontend)",
  "scripts": {
    "start:backend": "cd backend && npm start",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend-module && npm run dev",
    "build": "npm --prefix frontend-module run build",
    "build:frontend": "cd frontend-module && npm run build"
  }
}
